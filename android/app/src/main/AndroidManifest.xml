<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Queries for Banking Apps to allow Package Visibility on Android 11+ -->
    <queries>
        <package android:name="com.VCB" />
        <package android:name="com.mbmobile" />
        <package android:name="com.techcombank.mobile" />
        <package android:name="com.vnpay.agribank" />
        <package android:name="com.vnpay.bidv" />
        <package android:name="com.vietinbank.ipay" />
        <package android:name="com.vnpay.vpbank" />
        <package android:name="mobile.acb.com.vn" />
        <package android:name="src.com.sacombank" />
        <package android:name="com.tpb.mb.gprsandroid" />
        <package android:name="com.msb.mb" />
        <package android:name="com.hdbank.mb" />
        <package android:name="com.mplus.ocb" />
        <package android:name="com.vib.myvib" />
        <package android:name="com.shb.mobilebanking" />
        <package android:name="com.scb.mb" />
        <package android:name="vn.com.seabank.mb" />
        <package android:name="com.bab.mb" />
        <package android:name="com.abbank.mb" />
        <package android:name="com.namabank.mb" />
        <package android:name="com.vietbank.mb" />
        <package android:name="com.kienlongbank.mb" />
        <package android:name="com.saigonbank.mb" />
        <package android:name="com.pvcombank.mb" />
        <package android:name="com.oceanbank.mb" />
        <package android:name="com.baovietbank.mb" />
        <package android:name="com.shinhan.smartbanking" />
        <package android:name="com.wooribank.smart" />
        <package android:name="com.uob.mighty" />
        <package android:name="com.mservice.momotransfer" />
        <package android:name="vn.com.vng.zalopay" />
        <package android:name="com.bplus.vtpay" />
        <package android:name="com.vnpay.wallet" />
        <package android:name="vn.timo.digitalbanking" />
        <package android:name="xyz.be.cake" />
        <package android:name="msb.com.vn.tnex" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="vcb" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mbbank" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="momo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/AppTheme.NoActionBarLaunch">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Service tự động nhận thông báo biến động số dư các ngân hàng & ví điện tử -->
        <service
            android:name=".service.BankNotificationListenerService"
            android:exported="true"
            android:label="PiggyBite Bank Listener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>

</manifest>
